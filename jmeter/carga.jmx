<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="CanchaYa - Prueba de CARGA">
      <stringProp name="TestPlan.comments">Carga esperada: USUARIOS concurrentes durante DURACION segundos, con tiempo de pensamiento de 0,5 a 1,5 s. Cada usuario inicia sesión una sola vez y luego navega y reserva en bucle. Objetivo: verificar que con la carga normal todas las respuestas estén por debajo de MAX_MS y sin errores.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOLO" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOLO</stringProp>
            <stringProp name="Argument.value">${__P(protocolo,http)}</stringProp>
            <stringProp name="Argument.desc">http o https</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.desc">Servidor de la API</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PUERTO" elementType="Argument">
            <stringProp name="Argument.name">PUERTO</stringProp>
            <stringProp name="Argument.value">${__P(puerto,3000)}</stringProp>
            <stringProp name="Argument.desc">Puerto de la API</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(adminEmail,admin@canchaya.com)}</stringProp>
            <stringProp name="Argument.desc">Admin creado por npm run seed</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(adminPassword,Admin123!)}</stringProp>
            <stringProp name="Argument.desc"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CLIENTE_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">CLIENTE_EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(clienteEmail,cliente@canchaya.com)}</stringProp>
            <stringProp name="Argument.desc">Cliente creado por npm run seed</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CLIENTE_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">CLIENTE_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(clientePassword,Cliente123!)}</stringProp>
            <stringProp name="Argument.desc"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USUARIOS" elementType="Argument">
            <stringProp name="Argument.name">USUARIOS</stringProp>
            <stringProp name="Argument.value">${__P(usuarios,50)}</stringProp>
            <stringProp name="Argument.desc">Usuarios virtuales concurrentes</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <stringProp name="Argument.value">${__P(rampUp,30)}</stringProp>
            <stringProp name="Argument.desc">Segundos para llegar a todos los usuarios</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DURACION" elementType="Argument">
            <stringProp name="Argument.name">DURACION</stringProp>
            <stringProp name="Argument.value">${__P(duracion,120)}</stringProp>
            <stringProp name="Argument.desc">Duración total en segundos</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MAX_MS" elementType="Argument">
            <stringProp name="Argument.name">MAX_MS</stringProp>
            <stringProp name="Argument.value">${__P(maxMs,1000)}</stringProp>
            <stringProp name="Argument.desc">Tiempo máximo aceptable por petición (ms)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Valores por defecto HTTP">
        <intProp name="HTTPSampler.connect_timeout">5000</intProp>
