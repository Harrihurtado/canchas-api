                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;cancha&quot;:&quot;${__P(canchaId)}&quot;,&quot;fecha&quot;:&quot;${fechaReserva}&quot;,&quot;horaInicio&quot;:&quot;18:00&quot;,&quot;horaFin&quot;:&quot;19:00&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
