              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"cancha":"${__P(canchaId)}","fecha":"${fechaReserva}","horaInicio":"18:00","horaFin":"19:00"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Calcular fecha única para la reserva">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Cada usuario virtual y cada iteración reservan un día distinto,
// así las reservas nunca se cruzan entre sí y medimos rendimiento, no conflictos.
def dias = 1 + ctx.getThreadNum() * 400 + vars.getIteration()
vars.put("fechaReserva", java.time.LocalDate.now().plusDays(dias).toString())</stringProp>
        </JSR223PreProcessor>
