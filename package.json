{
  "name": "canchas-api",
  "version": "1.0.0",
  "description": "API REST de reservas de canchas deportivas - Pruebas de Software",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "seed": "cross-env NODE_ENV=development node scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "test:api": "npx -y -p newman@6 -p newman-reporter-htmlextra@1 newman run postman/CanchaYa.postman_collection.json -e postman/CanchaYa-local.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/newman/reporte-api.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
